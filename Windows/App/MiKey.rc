#include <windows.h>
#include "resource.h"
IDI_APP ICON "MiKey.ico"
1 24 "MiKey.manifest"
IDR_SOUND_VI RCDATA "Sounds/SwitchToVietnamese.wav"
IDR_SOUND_EN RCDATA "Sounds/SwitchToEnglish.wav"
IDR_EMOJI_JSON RCDATA "../../App/Resources/Emoji.json"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,14,0
 PRODUCTVERSION 1,0,14,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Tony Dinh"
      VALUE "FileDescription", "MiKey - Vietnamese typing"
      VALUE "FileVersion", VIKEY_VERSION
      VALUE "InternalName", "MiKey"
      VALUE "LegalCopyright", "GPL-3.0. Based on OpenKey by Tuyen Mai."
      VALUE "OriginalFilename", "MiKey.exe"
      VALUE "ProductName", "MiKey"
      VALUE "ProductVersion", VIKEY_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
